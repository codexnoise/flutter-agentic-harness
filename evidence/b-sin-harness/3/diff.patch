+/// Columna lateral de "Mi agenda" para pantallas anchas, con encabezado y
+/// contador de sesiones favoritas.
+class _MyAgendaPane extends StatelessWidget {
+  const _MyAgendaPane({required this.favorites, required this.child});
+
+  final ValueNotifier<Set<String>> favorites;
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return ColoredBox(
+      color: GoogleColors.wash(GoogleColors.yellow, 0.06),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 14, 16, 6),
+            child: Row(
+              children: [
+                const Icon(Icons.star_rounded, color: GoogleColors.yellow),
+                const SizedBox(width: 8),
+                Expanded(
+                  child: Text(
+                    'Mi agenda',
+                    style: theme.textTheme.titleMedium?.copyWith(
+                      fontWeight: FontWeight.w800,
+                      color: GoogleColors.ink(GoogleColors.yellow),
+                    ),
+                  ),
+                ),
+                ValueListenableBuilder<Set<String>>(
+                  valueListenable: favorites,
+                  builder: (context, ids, _) => Text(
+                    ids.length == 1 ? '1 sesión' : '${ids.length} sesiones',
+                    style: theme.textTheme.labelLarge?.copyWith(
+                      color: const Color(0xFF5F6368),
+                    ),
+                  ),
+                ),
+              ],
+            ),
           ),
+          Expanded(child: child),
         ],
       ),
     );
diff --git a/test/widget_test.dart b/test/widget_test.dart
index b8bacf3..ad0f5ed 100644
--- a/test/widget_test.dart
+++ b/test/widget_test.dart
@@ -1,12 +1,68 @@
 import 'package:devfest_agenda/main.dart';
+import 'package:flutter/services.dart';
 import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+
+void _setScreenSize(WidgetTester tester, Size size) {
+  tester.view.physicalSize = size;
+  tester.view.devicePixelRatio = 1;
+  addTearDown(tester.view.reset);
+}
 
 void main() {
+  // rootBundle cachea el Future del asset; uno creado en el FakeAsync de un
+  // test anterior nunca completa en el siguiente, así que lo descartamos.
+  setUp(() => rootBundle.evict('assets/devfest_agenda.json'));
+
   testWidgets('La app arranca y muestra la agenda', (tester) async {
+    _setScreenSize(tester, const Size(400, 800));
     await tester.pumpWidget(const DevFestAgendaApp());
     await tester.pumpAndSettle();
 
     expect(find.text('DevFest Agenda', findRichText: true), findsOneWidget);
     expect(find.text('Mi agenda'), findsOneWidget);
+    expect(find.byType(NavigationBar), findsOneWidget);
+  });
+
+  testWidgets('En pantallas anchas muestra agenda y Mi agenda lado a lado', (
+    tester,
+  ) async {
+    _setScreenSize(tester, const Size(1280, 800));
+    await tester.pumpWidget(const DevFestAgendaApp());
+    await tester.pumpAndSettle();
+
+    expect(find.byType(NavigationBar), findsNothing);
+    expect(find.text('Mi agenda'), findsOneWidget);
+    expect(find.text('0 sesiones'), findsOneWidget);
+    expect(
+      find.textContaining('Todavía no tienes sesiones favoritas'),
+      findsOneWidget,
+    );
+
+    await tester.tap(find.byTooltip('Agregar a Mi agenda').first);
+    await tester.pumpAndSettle();
+
+    expect(find.text('1 sesión'), findsOneWidget);
+    // La sesión aparece marcada en la agenda y también en Mi agenda.
+    expect(find.byTooltip('Quitar de Mi agenda'), findsNWidgets(2));
+  });
+
+  testWidgets('Los filtros se conservan al cambiar de layout', (tester) async {
+    _setScreenSize(tester, const Size(400, 800));
+    await tester.pumpWidget(const DevFestAgendaApp());
+    await tester.pumpAndSettle();
+
+    final firstChip = find.byType(FilterChip).first;
+    await tester.tap(firstChip);
+    await tester.pumpAndSettle();
+    expect(tester.widget<FilterChip>(firstChip).selected, isTrue);
+
+    _setScreenSize(tester, const Size(1280, 800));
+    await tester.pumpAndSettle();
+    expect(find.byType(NavigationBar), findsNothing);
+    expect(
+      tester.widget<FilterChip>(find.byType(FilterChip).first).selected,
+      isTrue,
+    );
   });
 }
