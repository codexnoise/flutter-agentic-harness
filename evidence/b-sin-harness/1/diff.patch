@@ -1,7 +1,34 @@
 import 'package:devfest_agenda/main.dart';
+import 'package:devfest_agenda/screens/agenda_screen.dart';
+import 'package:devfest_agenda/screens/my_agenda_screen.dart';
+import 'package:flutter/services.dart';
 import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
 
 void main() {
+  // rootBundle cachea el Future del asset; sin limpiarlo, un test reutiliza
+  // el Future creado en la zona de un test anterior y nunca completa.
+  setUp(rootBundle.clear);
+
+  void setScreenSize(WidgetTester tester, Size size) {
+    tester.view.physicalSize = size;
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+  }
+
+  /// Arranca la app y espera a que el JSON de la agenda (I/O real) cargue.
+  Future<void> pumpLoadedApp(WidgetTester tester) async {
+    await tester.pumpWidget(const DevFestAgendaApp());
+    for (var i = 0; i < 50; i++) {
+      if (find.byType(CircularProgressIndicator).evaluate().isEmpty) break;
+      await tester.runAsync(
+        () => Future<void>.delayed(const Duration(milliseconds: 20)),
+      );
+      await tester.pump();
+    }
+    await tester.pumpAndSettle();
+  }
+
   testWidgets('La app arranca y muestra la agenda', (tester) async {
     await tester.pumpWidget(const DevFestAgendaApp());
     await tester.pumpAndSettle();
@@ -9,4 +36,50 @@ void main() {
     expect(find.text('DevFest Agenda', findRichText: true), findsOneWidget);
     expect(find.text('Mi agenda'), findsOneWidget);
   });
+
+  testWidgets('En teléfono, Agenda y Mi agenda van en pestañas', (
+    tester,
+  ) async {
+    setScreenSize(tester, const Size(400, 800));
+    await pumpLoadedApp(tester);
+
+    expect(find.byType(NavigationBar), findsOneWidget);
+    expect(find.byType(VerticalDivider), findsNothing);
+  });
+
+  testWidgets('En tablet, Agenda y Mi agenda se muestran lado a lado', (
+    tester,
+  ) async {
+    setScreenSize(tester, const Size(1280, 800));
+    await pumpLoadedApp(tester);
+
+    expect(find.byType(NavigationBar), findsNothing);
+    expect(find.byType(AgendaScreen), findsOneWidget);
+    expect(find.byType(MyAgendaScreen), findsOneWidget);
+    expect(find.text('0 sesiones'), findsOneWidget);
+
+    final agendaRect = tester.getRect(find.byType(AgendaScreen));
+    final myAgendaRect = tester.getRect(find.byType(MyAgendaScreen));
+    expect(agendaRect.right, lessThanOrEqualTo(myAgendaRect.left));
+
+    // Marcar una favorita en la agenda la muestra al instante en Mi agenda.
+    await tester.tap(
+      find
+          .descendant(
+            of: find.byType(AgendaScreen),
+            matching: find.byIcon(Icons.star_outline_rounded),
+          )
+          .first,
+    );
+    await tester.pumpAndSettle();
+
+    expect(find.text('1 sesión'), findsOneWidget);
+    expect(
+      find.descendant(
+        of: find.byType(MyAgendaScreen),
+        matching: find.byIcon(Icons.star_rounded),
+      ),
+      findsOneWidget,
+    );
+  });
 }
