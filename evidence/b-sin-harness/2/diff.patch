+/// Panel de Mi agenda para el layout ancho: encabezado con conteo + lista.
+class _MyAgendaPane extends StatelessWidget {
+  const _MyAgendaPane({required this.favorites, required this.child});
+
+  final ValueNotifier<Set<String>> favorites;
+  final Widget child;
+
+  @override
