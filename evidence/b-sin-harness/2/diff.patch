+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 14, 16, 6),
+            child: ValueListenableBuilder<Set<String>>(
+              valueListenable: favorites,
+              builder: (context, ids, _) => Row(
+                children: [
