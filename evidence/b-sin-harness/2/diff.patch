diff --git a/test/widget_test.dart b/test/widget_test.dart
index b8bacf3..caa1d7c 100644
--- a/test/widget_test.dart
+++ b/test/widget_test.dart
@@ -1,12 +1,79 @@
 import 'package:devfest_agenda/main.dart';
+import 'package:devfest_agenda/screens/agenda_screen.dart';
+import 'package:devfest_agenda/screens/my_agenda_screen.dart';
+import 'package:flutter/services.dart';
 import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+
+Future<void> _pumpAt(WidgetTester tester, Size size) async {
+  tester.view.physicalSize = size;
+  tester.view.devicePixelRatio = 1;
+  addTearDown(tester.view.reset);
+  await tester.pumpWidget(const DevFestAgendaApp());
+  await tester.pumpAndSettle();
+}
 
 void main() {
+  // rootBundle cachea el Future del asset creado en la zona del test anterior.
+  setUp(rootBundle.clear);
+
   testWidgets('La app arranca y muestra la agenda', (tester) async {
-    await tester.pumpWidget(const DevFestAgendaApp());
-    await tester.pumpAndSettle();
+    await _pumpAt(tester, const Size(400, 800));
 
     expect(find.text('DevFest Agenda', findRichText: true), findsOneWidget);
     expect(find.text('Mi agenda'), findsOneWidget);
   });
+
+  testWidgets('En pantalla angosta usa pestañas', (tester) async {
+    await _pumpAt(tester, const Size(400, 800));
+
+    expect(find.byType(NavigationBar), findsOneWidget);
+    // Mi agenda existe en el IndexedStack pero no está visible.
+    expect(find.byType(MyAgendaScreen), findsNothing);
+    expect(find.byType(MyAgendaScreen, skipOffstage: false), findsOneWidget);
+  });
+
+  testWidgets('En tablet muestra Agenda y Mi agenda lado a lado', (
+    tester,
+  ) async {
+    await _pumpAt(tester, const Size(1024, 768));
+
+    expect(find.byType(NavigationBar), findsNothing);
+    expect(find.byType(AgendaScreen), findsOneWidget);
+    expect(find.byType(MyAgendaScreen), findsOneWidget);
+    expect(
+      tester.getCenter(find.byType(AgendaScreen)).dx,
+      lessThan(tester.getCenter(find.byType(MyAgendaScreen)).dx),
+    );
+
+    // Marcar una favorita en la agenda la muestra al instante en Mi agenda.
+    expect(find.textContaining('Todavía no tienes'), findsOneWidget);
+    await tester.tap(
+      find
+          .descendant(
+            of: find.byType(AgendaScreen),
+            matching: find.byIcon(Icons.star_outline_rounded),
+          )
+          .first,
+    );
+    await tester.pumpAndSettle();
+    expect(find.textContaining('Todavía no tienes'), findsNothing);
+    expect(find.text('1 sesión'), findsOneWidget);
+  });
+
+  testWidgets('Los filtros se conservan al cambiar de layout', (tester) async {
+    await _pumpAt(tester, const Size(1024, 768));
+
+    final chip = find.byType(FilterChip).first;
+    await tester.tap(chip);
+    await tester.pumpAndSettle();
+    expect(tester.widget<FilterChip>(chip).selected, isTrue);
+
+    tester.view.physicalSize = const Size(400, 800);
+    await tester.pumpAndSettle();
+    expect(
+      tester.widget<FilterChip>(find.byType(FilterChip).first).selected,
+      isTrue,
+    );
+  });
 }
