@@ -0,0 +1,12 @@
+/// Breakpoints de layout, en píxeles lógicos del ancho disponible.
+///
+/// Único lugar donde se definen: los widgets los comparan contra las
+/// constraints de un `LayoutBuilder`, nunca contra el tamaño de pantalla.
+abstract final class Breakpoints {
+  /// A partir de este ancho, la Agenda y Mi agenda se muestran lado a lado
+  /// (clase de ventana "expanded" de Material 3).
+  static const double twoPane = 840;
+
+  /// Ancho fijo del panel de Mi agenda en el layout de dos paneles.
+  static const double myAgendaPaneWidth = 380;
+}
