diff --git a/test/two_pane_layout_test.dart b/test/two_pane_layout_test.dart
new file mode 100644
index 0000000..edb6fb3
--- /dev/null
+++ b/test/two_pane_layout_test.dart
@@ -0,0 +1,78 @@
+import 'package:devfest_agenda/data/agenda_repository.dart';
+import 'package:devfest_agenda/layout/breakpoints.dart';
+import 'package:devfest_agenda/main.dart';
+import 'package:devfest_agenda/models/session.dart';
+import 'package:devfest_agenda/screens/agenda_screen.dart';
+import 'package:devfest_agenda/screens/my_agenda_screen.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+
+class _FakeAgendaRepository extends AgendaRepository {
+  @override
+  Future<List<Session>> loadSessions() async => const [
+    Session(
+      id: 's1',
+      title: 'Flutter en tablets',
+      speaker: 'Ada',
+      track: 'Mobile',
+      time: '09:00',
+      room: 'Sala A',
+      level: 'Intro',
+      lang: 'ES',
+      illustrative: false,
+    ),
+  ];
+}
+
+Future<void> _pumpApp(WidgetTester tester, {required double width}) async {
+  tester.view.devicePixelRatio = 1;
+  tester.view.physicalSize = Size(width, 900);
+  addTearDown(tester.view.reset);
+  await tester.pumpWidget(
+    DevFestAgendaApp(repository: _FakeAgendaRepository()),
+  );
+  await tester.pumpAndSettle();
+}
+
+void main() {
+  testWidgets('En pantallas anchas muestra Agenda y Mi agenda lado a lado', (
+    tester,
+  ) async {
+    await _pumpApp(tester, width: Breakpoints.twoPane + 200);
+
+    expect(find.byType(AgendaScreen), findsOneWidget);
+    expect(find.byType(MyAgendaScreen), findsOneWidget);
+    expect(find.byType(NavigationBar), findsNothing);
+    expect(find.textContaining('Todavía no tienes'), findsOneWidget);
+
+    // Marcar una favorita en la agenda la muestra en el panel de Mi agenda.
+    await tester.tap(find.byTooltip('Agregar a Mi agenda'));
+    await tester.pump();
+
+    final myAgendaPane = find.byType(MyAgendaScreen);
+    expect(
+      find.descendant(
+        of: myAgendaPane,
+        matching: find.text('Flutter en tablets'),
+      ),
+      findsOneWidget,
+    );
+    expect(find.textContaining('Todavía no tienes'), findsNothing);
+  });
+
+  testWidgets('En pantallas angostas usa pestañas con NavigationBar', (
+    tester,
+  ) async {
+    await _pumpApp(tester, width: Breakpoints.twoPane - 1);
+
+    expect(find.byType(NavigationBar), findsOneWidget);
+    // IndexedStack: Mi agenda existe pero no está visible.
+    expect(find.byType(MyAgendaScreen, skipOffstage: false), findsOneWidget);
+    expect(find.byType(MyAgendaScreen), findsNothing);
+
+    await tester.tap(find.text('Mi agenda'));
+    await tester.pumpAndSettle();
+    expect(find.byType(MyAgendaScreen), findsOneWidget);
+    expect(find.byType(AgendaScreen), findsNothing);
+  });
+}
