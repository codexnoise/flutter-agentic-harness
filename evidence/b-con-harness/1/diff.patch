+import 'dart:convert';
+
+import 'package:flutter/services.dart';
+
+import '../models/session.dart';
+
+/// Fuente única de las sesiones del DevFest.
+abstract class AgendaRepository {
+  /// Sesiones ordenadas por hora y, a igual hora, por título.
+  Future<List<Session>> loadSessions();
+}
+
+/// Lee la agenda desde `assets/devfest_agenda.json`.
+class AssetAgendaRepository implements AgendaRepository {
+  AssetAgendaRepository({AssetBundle? bundle}) : _bundle = bundle ?? rootBundle;
+
+  static const assetPath = 'assets/devfest_agenda.json';
+
+  final AssetBundle _bundle;
+  List<Session>? _cache;
+
+  @override
+  Future<List<Session>> loadSessions() async {
+    final cached = _cache;
+    if (cached != null) return cached;
+
+    final raw = await _bundle.loadString(assetPath);
+    final data = jsonDecode(raw) as List<dynamic>;
+    final sessions = data
+        .map((e) => Session.fromJson(e as Map<String, dynamic>))
+        .toList();
+    sessions.sort((a, b) {
+      final byTime = a.time.compareTo(b.time);
+      return byTime != 0 ? byTime : a.title.compareTo(b.title);
+    });
+    return _cache = List.unmodifiable(sessions);
+  }
+}
