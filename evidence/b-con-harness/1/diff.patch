--- /dev/null
+++ b/lib/layout/breakpoints.dart
@@ -0,0 +1,12 @@
+/// Breakpoints de layout, en píxeles lógicos del espacio disponible.
+///
+/// Se comparan contra `BoxConstraints.maxWidth` de un `LayoutBuilder`,
+/// nunca contra el tamaño de la pantalla ni el tipo de dispositivo.
+abstract final class Breakpoints {
+  /// Ancho a partir del cual la Agenda y Mi agenda se muestran lado a lado.
+  static const double twoPaneMinWidth = 720;
+
+  /// Proporción del ancho para la Agenda frente a Mi agenda en dos paneles.
+  static const int agendaPaneFlex = 3;
+  static const int myAgendaPaneFlex = 2;
+}
