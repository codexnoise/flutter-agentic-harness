@@ -0,0 +1,13 @@
+/// Breakpoints de layout de la app. Único lugar donde se definen.
+///
+/// Se comparan contra el ancho disponible que entrega `LayoutBuilder`,
+/// nunca contra el tamaño de pantalla ni el tipo de dispositivo.
+abstract final class Breakpoints {
+  /// Ancho mínimo para mostrar Agenda y Mi agenda lado a lado
+  /// (cubre iPad en vertical desde 744 pt).
+  static const double sideBySideMinWidth = 720;
+
+  /// Proporción de ancho Agenda : Mi agenda en el layout lado a lado.
+  static const int agendaPaneFlex = 3;
+  static const int myAgendaPaneFlex = 2;
+}
